---
// A ficha de um personagem: /<idioma>/characters/<pasta>/ (só existe com `show_extras: true`). O <main> do build() (linhas ~905–911):
//   <article class="wrap block char-page"> [rascunho] [retrato] <div class="prose"> <p class="crumb"> <h1> <p class="role"> texto [Aparece em] [Veja também] </div> </article>
// Só desenha: tudo vem decidido em `ficha` (src/lib/paginasDeExtras.ts). Escrito "colado" de propósito: não quebre as linhas do HTML.
import "../styles/prosa.css";
import { assetUrl } from "../lib/assets";
import { textoDoAutor } from "../lib/pagina";
import type { FichaDePersonagem } from "../lib/paginasDeExtras";
import CartaQueVira from "./CartaQueVira.astro";
import PostsAlternados from "./PostsAlternados.astro";
import Relacionados from "./Relacionados.astro";

interface Props {
  ficha: FichaDePersonagem;
}

const { ficha: f } = Astro.props;
---

<article class="wrap block char-page">{f.avisoDeRascunho && <p class="draft-banner">{f.avisoDeRascunho}</p>}{f.imagem && <img class="portrait" src={assetUrl(f.imagem)} alt={f.titulo} />}<div class="prose"><p class="crumb"><a href={f.migalha.url}>{f.migalha.rotulo}</a></p>
<h1>{f.titulo}</h1><p class="role">{f.papel}</p><Fragment set:html={textoDoAutor(f.html)} />{f.apareceEm && <Relacionados rotulo={f.apareceEm.rotulo} links={f.apareceEm.links} />}{f.relacionados && <Relacionados rotulo={f.relacionados.rotulo} links={f.relacionados.links} />}</div></article>
{f.temCartaQueVira && <CartaQueVira />}
{f.temPostsAlternados && <PostsAlternados />}

<style is:global>
  @layer site {
    /* Copiado de static/style.css (seção "universo / personagens", a parte da ficha), mesmos valores e mesma ordem; o celular (700 px) vem no @media do original. */
    .char-page { display: grid; grid-template-columns: minmax(200px, 320px) 1fr; gap: 2.2rem; align-items: start; }
    .char-page:not(:has(.portrait)) { grid-template-columns: 1fr; max-width: 760px; }
    .portrait { width: 100%; border-radius: var(--radius); box-shadow: 0 6px 18px #0003; }
    .role { color: var(--teal); font-weight: 600; margin-top: -.6em; }
    .crumb { font-size: .85rem; margin: 0 0 .5rem; }
    @media (max-width: 700px) { .char-page { grid-template-columns: 1fr; } .portrait { max-width: 260px; } }
  }
</style>
