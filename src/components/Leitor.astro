---
// O LEITOR de um capítulo: o miolo inteiro da página /pt/works/<obra>/<capítulo>/ (o `inner` do build.py, ~788–827).
// Duas "folhas": a de cima com o capítulo (prosa, vídeo ou quadrinho) e a de baixo, fina, com os comentários.
// Só desenha: tudo vem decidido em `leitura` (src/lib/leitura.ts). O texto do autor entra como HTML pronto
// (`nota`, feito pelo carregador a partir do Markdown, T09), marcado por textoDoAutor() (src/lib/pagina.ts: o acabamento
// do <main> não mexe nele além do que o Python mexe), e os efeitos dele (sonho de Ossos, Giuseppe, a carta que
// vira, as tiras, o degradê de Pederneira) funcionam pelas classes e estilos que o próprio texto traz: o CSS está em
// src/styles/prosa.css. O versalete é aplicado depois, UMA vez, no <main> inteiro (BaseLayout → finalizarMain).
//
// ⚠ Este arquivo é escrito "colado" de propósito: espaço entre dois elementos em linha (um <a> e outro <a>) aparece na
// tela, e o teste compara a estrutura com a do site atual. Não quebre as linhas longas do HTML abaixo.
import "../styles/prosa.css";
import type { LeituraDoCapitulo } from "../lib/leitura";
import { assetUrl } from "../lib/assets";
import { textoDoAutor } from "../lib/pagina";
import CabecalhoDoCapitulo from "./CabecalhoDoCapitulo.astro";
import CartaQueVira from "./CartaQueVira.astro";
import Comentarios from "./Comentarios.astro";
import Pager from "./Pager.astro";
import PostsAlternados from "./PostsAlternados.astro";
import Seta from "./Seta.astro";

interface Props {
  leitura: LeituraDoCapitulo;
}

const { leitura: l } = Astro.props;
const c = l.conteudo;
---

{c.formato === "prose" && <div class="reader-box paper">{l.avisoDeRascunho && <p class="draft-banner">{l.avisoDeRascunho}</p>}<CabecalhoDoCapitulo cabecalho={l.cabecalho} /><hr class="thin" /><div class={c.fonteTimes ? "prose story font-times" : "prose story"}><Fragment set:html={textoDoAutor(c.nota)} /></div>{c.paginador && <Pager paginador={c.paginador} />}</div>}
{c.formato === "video" && <div class="reader-box paper">{l.avisoDeRascunho && <p class="draft-banner">{l.avisoDeRascunho}</p>}<CabecalhoDoCapitulo cabecalho={l.cabecalho} />{c.lados ? <div class="player-row">{c.lados.anterior ? <a class="side-btn prev" rel="prev" href={c.lados.anterior.url} title={c.lados.anterior.rotulo} aria-label={c.lados.anterior.rotulo}><Seta direcao="prev" /></a> : <span class="side-btn prev ghost"></span>}<div class="video-wrapper"><iframe src={`https://www.youtube.com/embed/${c.youtube}`} allowfullscreen title={c.tituloDoVideo}></iframe></div>{c.lados.proximo ? <a class="side-btn next" rel="next" href={c.lados.proximo.url} title={c.lados.proximo.rotulo} aria-label={c.lados.proximo.rotulo}><Seta direcao="next" /></a> : <span class="side-btn next ghost"></span>}</div> : <div class="video-wrapper"><iframe src={`https://www.youtube.com/embed/${c.youtube}`} allowfullscreen title={c.tituloDoVideo}></iframe></div>}{c.nota && <div class="prose"><Fragment set:html={textoDoAutor(c.nota)} /></div>}{c.paginador && <Pager paginador={c.paginador} />}</div>}
{c.formato === "comic" && <div class="reader-box">{l.avisoDeRascunho && <p class="draft-banner">{l.avisoDeRascunho}</p>}<CabecalhoDoCapitulo cabecalho={l.cabecalho} />{c.paginador && <Pager paginador={c.paginador} />}<div class="comic">{c.paginas.map((p) => <img src={assetUrl(p.arquivo)} alt={p.alt} loading="lazy" />)}</div>{c.nota && <div class="author-note prose"><Fragment set:html={textoDoAutor(c.nota)} /></div>}{c.paginador && <Pager paginador={c.paginador} />}</div>}
<div class="reader-box paper slim">{l.comentarios && <Comentarios secao={l.comentarios} />}</div>
{l.temCartaQueVira && <CartaQueVira />}
{l.temPostsAlternados && <PostsAlternados />}

<style is:global>
  @layer site {
    /* Copiado de static/style.css (seções "leitor (capítulos)", "Luz & Sangue: botões de episódio ao lado do vídeo" e
       "Ossos do Ofício … Times New Roman"), mesmos valores e mesma ordem. O que é do texto do autor (divisor, carta, sonho,
       tiras, Giuseppe…) está em src/styles/prosa.css; o .pager, em Pager.astro; os comentários, em Comentarios.astro. */
    .reader-box { max-width: 1000px; width: calc(100% - 2rem); margin: 0 auto 1.5rem; padding: clamp(1.4rem, 5vw, 3.5rem); border-radius: var(--sheet-radius); box-shadow: 0 12px 34px #00000040; }
    .reader-box.paper { background: var(--paper), var(--sheet); background-color: var(--sheet); }
    .reader-box.slim { padding-top: .8rem; padding-bottom: .8rem; }
    .title-image { display: block; margin: 0 auto 1.5rem; height: 100px; width: auto; }
    .chapter-title { text-align: center; font-size: clamp(1.25rem, 2.6vw, 1.6rem); margin-bottom: 1rem; }
    hr.thin { width: 80%; border: 0; border-top: 1px solid #0003; margin: 0 auto 2rem; }
    .reader .prose { max-width: none; }
    .story { font-size: 1.04rem; line-height: 1.9; color: #0e0e0e; }
    .story p { margin: 0 0 1.15em; text-align: justify; }
    .story figure img { display: block; margin: 1.5rem auto; }

    /* quadrinho: a primeira folha fica escura (roxo-noite) */
    .reader-comic .reader-box:first-of-type { background: var(--night); color: #dff6ee; padding: 1.5rem clamp(.5rem, 3vw, 2rem); }
    .reader-comic .title-image { height: 70px; }
    .reader-comic .chapter-title { color: #fff; }
    .comic { display: flex; flex-direction: column; align-items: center; margin: 1rem 0; }
    .comic img { display: block; width: 100%; max-width: 860px; }
    .author-note { margin: 1.5rem auto 0; padding: 1rem 1.2rem; background: #ffffff12; border-radius: 10px; }
    .reader-comic .pager .mid, .reader-comic .pager .pg { color: var(--mint); }

    @media (max-width: 700px) {
      .story p { text-align: left; }
    }

    /* ── Luz & Sangue: botões de episódio ao lado do vídeo ── */
    .player-row { display: grid; grid-template-columns: 52px minmax(0, 1fr) 52px; grid-template-areas: "p v n"; gap: 1rem; align-items: center; }
    .player-row .video-wrapper { grid-area: v; }
    .side-btn { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--green); color: #eafff8; box-shadow: 0 4px 14px #0004; transition: transform .2s, box-shadow .3s; }
    .side-btn svg { width: 28px; height: 28px; }
    a.side-btn:hover { transform: scale(1.08); box-shadow: 0 0 14px var(--cyan); color: #fff; }
    .side-btn.prev { grid-area: p; } .side-btn.next { grid-area: n; }
    .side-btn.ghost { visibility: hidden; }
    @media (max-width: 700px) {
      .player-row { grid-template-columns: 1fr 1fr; grid-template-areas: "v v" "p n"; }
      .side-btn.next { justify-self: end; }
    }

    /* ── fonte de leitura "times" (work.json → reading_font): Ossos do Ofício e Pederneira ── */
    .story.font-times { font-family: "Times New Roman", Times, serif; font-size: 1.08rem; line-height: 1.7; }
    .story.font-times p { margin: 0; }          /* sem espaço entre parágrafos (Ossos do Ofício e Pederneira) */
    .reader-comic .title-image { filter: invert(1); }   /* logo preta continua legível no fundo escuro das HQs */

    .chapter-date { text-align: center; margin: -.6rem 0 1rem; }
  }
</style>
