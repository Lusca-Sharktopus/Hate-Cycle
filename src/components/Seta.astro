---
// A seta dos botões "anterior"/"próximo" (arrow() do build.py): um triângulo vazado em SVG.
interface Props {
  direcao: "prev" | "next";
}

const { direcao } = Astro.props;
const d = direcao === "next" ? "M8 4.5v15l11.5-7.5z" : "M16 4.5v15L4.5 12z";
---

<svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
