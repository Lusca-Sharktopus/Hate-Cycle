---
// Posts incorporados do X, do Reddit e do Instagram SÓ COM CLIQUE (T17g, B27): o script e o CSS do quadro "Mostrar post do X".
// O HTML do quadro não é desenhado aqui: ele nasce no build, dentro do <main>, em src/lib/embedsComClique.ts (que também tira os
// scripts de terceiros). Este componente só traz o clique e o visual, e o BaseLayout só o põe na página quando o <main> tem
// pelo menos um quadro. Lição: docs/aprendendo-astro/08-leitor.md (seção "Posts incorporados só com clique").
---

<script>
  import "../scripts/embeds/index";
</script>

<style is:global>
  @layer site {
    /* O quadro antes do clique: caixa tracejada no lugar do post, com o texto do autor (o blockquote), o aviso, o botão e o link para o
       original. Sem JavaScript sobram o blockquote e o link (o aviso e o botão vêm com `hidden`). O gate usa display: contents para
       que a ordem visual possa ser decidida aqui: status em cima, o post (iframe), depois o link para o original. */
    .embed[data-embed-servico] { flex-direction: column; align-items: center; gap: .7rem; padding: 1rem; border: 2px dashed var(--green); border-radius: var(--radius); background: #ffffffa8; text-align: center; overflow-x: visible; }
    .embed[data-embed-servico] .embed-gate { display: contents; }
    .embed[data-embed-servico] > blockquote { height: auto !important; margin: 0; padding: 0; border: 0; max-width: 100%; color: var(--ink); overflow-wrap: anywhere; }
    .embed[data-embed-servico] > blockquote a { color: var(--green); }
    .embed-gate-aviso { margin: 0; font-size: .95rem; color: var(--ink); }
    .embed-load { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .6rem 1.4rem; border: 2px solid var(--green); border-radius: 999px; background: var(--green); color: #fff; font: 600 1rem var(--font-text); cursor: pointer; }
    .embed-load:hover { background: var(--teal); border-color: var(--teal); }
    .embed-load:focus-visible { outline: 3px solid var(--night); outline-offset: 3px; }
    .embed-origin { order: 2; font-size: .9rem; color: var(--green); text-decoration: underline; text-underline-offset: .15em; overflow-wrap: anywhere; }
    .embed-origin:focus-visible { outline: 3px solid var(--night); outline-offset: 3px; }
    .embed-status { order: -2; margin: 0; font-size: .9rem; color: var(--muted); }
    .embed-status:empty { display: none; }
    .embed-gate-aviso[hidden], .embed-load[hidden] { display: none; }
    /* o link "↗ X" que o markdown põe embaixo dos posts vindos de link repete o link do quadro */
    .embed[data-embed-servico] + .embed-open { display: none; }

    /* depois do clique: o quadro vira só o post (iframe) com o status em cima e o link embaixo */
    .embed[data-estado="carregando"], .embed[data-estado="carregado"] { padding: 0; border-color: transparent; background: none; }
    .embed[data-estado="carregando"] > blockquote, .embed[data-estado="carregado"] > blockquote,
    .embed[data-estado="carregando"] .embed-gate-aviso, .embed[data-estado="carregado"] .embed-gate-aviso { display: none; }
    /* "Post carregado." é para o leitor de tela (a região de status): na tela, quem vê o post já sabe. Se o quadro carregou em branco, o
       link para o original embaixo continua à vista. */
    .embed[data-estado="carregado"] .embed-status { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .embed-frame { order: -1; display: block; width: 100%; max-width: 100%; border: 0; background: transparent; color-scheme: light; }
  }
</style>
