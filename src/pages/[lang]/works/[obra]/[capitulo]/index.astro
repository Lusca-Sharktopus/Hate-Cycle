---
// A página de cada capítulo: /pt/works/firestriker/01/, /en/works/light-and-blood/02/… (rota ANINHADA: [obra] e [capitulo]).
// getStaticPaths() cria uma página por capítulo de cada obra (inclusive obras escondidas das listas e capítulos
// `unlisted`, que existem mas ficam fora dos buscadores) — o laço dos capítulos do build() do build.py (~788–828).
// Rascunhos (`draft: true`) só existem na prévia (pnpm dev), como no `python build.py serve`.
// Tudo o que a página mostra vem decidido de src/lib/leitura.ts; o Leitor só desenha. Lição: docs/aprendendo-astro/08-leitor.md.
import { join } from "node:path";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Leitor from "../../../../../components/Leitor.astro";
import { comentariosDaPagina } from "../../../../../lib/comentarios";
import { langs, type Lang } from "../../../../../lib/config";
import { COM_RASCUNHOS, dadosDoIdioma } from "../../../../../lib/conteudo";
import { leiturasDaObra, type LeituraDoCapitulo } from "../../../../../lib/leitura";
import { blocoDaOrdem, type BlocoDaOrdem } from "../../../../../lib/ordemDeLeitura";
import { arquivosDoGlob } from "../../../../../lib/quadrinhos";

export async function getStaticPaths() {
  // os capítulos de cada obra nos DOIS idiomas: servem para o seletor de idioma (o mesmo capítulo no outro idioma)
  const porIdioma = await Promise.all(langs.map(async (lang) => [lang, await dadosDoIdioma(lang)] as const));
  const dadosDe = Object.fromEntries(porIdioma) as Record<Lang, Awaited<ReturnType<typeof dadosDoIdioma>>>;
  const pastaStatic = join(process.cwd(), "static");
  const ferramentas = {
    glob: (padrao: string) => arquivosDoGlob(pastaStatic, padrao),
    comentarios: (lang: Lang, id: string | null) => comentariosDaPagina(lang, id, COM_RASCUNHOS),
  };
  const outrosIdiomas = (lang: Lang) => (o: (typeof dadosDe)[Lang]["obras"][number]) => langs.filter((l) => l !== lang).map((l) => ({ lang: l, capitulos: dadosDe[l].capitulosDe(o) }));
  const saidas = [];
  for (const lang of langs) {
    for (const obra of dadosDe[lang].obras) {
      const capitulos = Object.fromEntries(langs.map((l) => [l, dadosDe[l].capitulosDe(obra)])) as Record<Lang, ReturnType<(typeof dadosDe)[Lang]["capitulosDe"]>>;
      // o bloco "estou lendo em ordem…" (T17c) é o mesmo para todos os capítulos da obra: quem vem antes e depois dela, nas duas ordens
      // (os capítulos dos outros idiomas: para a obra que só tem capítulo em outro idioma, T17l)
      const ordem = blocoDaOrdem(obra, lang, dadosDe[lang].universo, dadosDe[lang].capitulosDe, COM_RASCUNHOS, outrosIdiomas(lang));
      for (const leitura of leiturasDaObra(obra, lang, capitulos, ferramentas)) {
        saidas.push({ params: { lang, obra: obra.data._origem.slug, capitulo: leitura.pasta }, props: { leitura, ordem } });
      }
    }
  }
  return saidas;
}

const lang = Astro.params.lang as Lang;
const { leitura, ordem } = Astro.props as { leitura: LeituraDoCapitulo; ordem: BlocoDaOrdem };
---

<BaseLayout lang={lang} title={leitura.tituloDaPagina} description={leitura.descricao} image={leitura.imagem} alternates={leitura.alternativas} noindex={leitura.noindex} bodyClass={leitura.classeDoCorpo}>
  <Leitor leitura={leitura} ordem={ordem} />
</BaseLayout>
